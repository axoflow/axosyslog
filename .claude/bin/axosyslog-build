#!/usr/bin/env bash
# axosyslog-build -- one wrapper for building & testing AxoSyslog.
#
# It encapsulates the four build modes and their legitimate flavors so there is
# always a correct build path.
#
# cmake and autotools work in any checkout -- a plain clone, a branch, or a git
# worktree -- and build out-of-tree in build/; dbld and alpine need a plain
# checkout.
#
# Usage:  axosyslog-build [mode] [flavors] [actions]
#
#   modes:   cmake|cm (default) | autotools|auto|at | dbld | alpine
#            dbld builds in the build container under dbld/build/ and installs
#            to dbld/install/; alpine produces the musl production docker image.
#
#   The default is cmake with the full development stack: clang, lld, ninja,
#   the filterx LLVM JIT, and the AddressSanitizer. Missing tooling for the
#   selected setup fails early with an install hint (native modes only).
#
#   flavors: --sanitizer=address|thread|undefined|none
#                                  default: address (dbld: none; alpine: fixed
#                                  production build, rejects the flag)
#            --clean               fresh out-of-tree build dir + lib/ivykis recovery;
#                                  also the supported way to switch modes in a tree
#            --monolithic          link modules into the core lib (autotools/dbld only;
#                                  --with-linking-mode=monolithic). Default: dynamic.
#            -j N | --jobs N       build parallelism, cmake/autotools only
#                                  (dbld/alpine manage their own). Default:
#                                  AXOSYSLOG_BUILD_JOBS if set, else nproc-2,
#                                  floor 1.
#            --no-install          skip the install step (cmake/autotools only)
#            --no-jit              disable the filterx LLVM JIT (default: on)
#            --no-lld              link with the default linker instead of lld
#                                  (cmake only; lld is on by default)
#
#   actions: --check               run the unit tests after the build (alpine:
#                                  they already ran inside the image build)
#            --light               run the light/e2e suite after build+install
#                                  (alpine: runs against the built image)
#
#   Arguments after `--` go to that action's test runner, so pass them with a
#   single action: ctest on cmake (`--check -- -R <name>` runs a single test),
#   make check on autotools/dbld, pytest for --light (e.g. --light -- -k name
#   -n0). They cannot carry spaces or globs (the runner re-splits them).
#
# Flavors are a closed set -- add new ones here on purpose rather than improvising
# configure flags.
set -euo pipefail

MODE=""
JOBS=""
SANITIZER=""
CLEAN=0
MONOLITHIC=0
DO_INSTALL=1
NO_JIT=0
NO_LLD=0
DO_CHECK=0
DO_LIGHT=0
EXTRA_ARGS=()

CC="${CC:-clang}"
CXX="${CXX:-clang++}"

say()  { printf '\033[1;34m>>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
fail() { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} /^$/{print; next} {exit}' "$0"
  exit "${1:-0}"
}

have() { command -v "$1" >/dev/null 2>&1; }

# presence hint only -- catches a host with no LLVM at all; the build systems do the real discovery
have_llvm() {
  have llvm-config && return 0
  local c
  for c in /usr/bin/llvm-config-* /usr/lib/llvm-*/bin/llvm-config \
           /opt/homebrew/opt/llvm/bin/llvm-config /usr/local/opt/llvm/bin/llvm-config; do
    [ -x "$c" ] && return 0
  done
  return 1
}

have_ax_macros() {
  # check the macro file, not just the dir: the aclocal dir preexists with
  # automake's own macros, so a dir test false-passes without autoconf-archive
  local d
  for d in "$(aclocal --print-ac-dir 2>/dev/null)" /usr/local/share/aclocal /opt/homebrew/share/aclocal; do
    [ -n "$d" ] && [ -f "$d/ax_prefix_config_h.m4" ] && return 0
  done
  return 1
}

default_jobs() {
  local n
  n="$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)"
  if [ "$n" -gt 2 ]; then echo $((n - 2)); else echo 1; fi
}

case "${1:-}" in
  ""|-*)     MODE=cmake ;;   # a leading flag (incl. -h) keeps the default and falls into the loop
  *)         MODE="$1"; shift ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --sanitizer=*)  SANITIZER="${1#*=}"; [ -n "$SANITIZER" ] || fail "--sanitizer= needs a value" ;;
    --sanitizer)    shift; [ $# -gt 0 ] || fail "--sanitizer needs a value"; SANITIZER="$1" ;;
    --clean)        CLEAN=1 ;;
    --monolithic)   MONOLITHIC=1 ;;
    -j|--jobs)      shift; [ $# -gt 0 ] || fail "-j needs a value"; JOBS="$1" ;;
    -j*)            JOBS="${1#-j}" ;;
    --jobs=*)       JOBS="${1#*=}" ;;
    --no-install)   DO_INSTALL=0 ;;
    --no-jit)       NO_JIT=1 ;;
    --no-lld)       NO_LLD=1 ;;
    --check)        DO_CHECK=1 ;;
    --light)        DO_LIGHT=1 ;;
    --)             shift; EXTRA_ARGS=("$@"); break ;;
    -h|--help)      usage 0 ;;
    *)              fail "unknown argument: $1  (flavors are a closed set; add new ones to axosyslog-build on purpose)" ;;
  esac
  shift
done

# -j must be a positive integer -- else `-j <flag>` swallows the next arg as the count
if [ -n "$JOBS" ]; then
  case "$JOBS" in
    *[!0-9]*|'') fail "invalid -j '$JOBS'  (want a positive integer)" ;;
  esac
fi

case "$MODE" in
  autotools|auto|at) MODE=autotools ;;
  cmake|cm)          MODE=cmake ;;
  dbld)              MODE=dbld ;;
  alpine)            MODE=alpine ;;
  *) fail "unknown mode: '$MODE'  (want: cmake | autotools | dbld | alpine)" ;;
esac

case "$SANITIZER" in
  ""|address|thread|undefined|none) ;;
  *) fail "invalid --sanitizer='$SANITIZER'  (want: address | thread | undefined | none)" ;;
esac

# ASan by default (an uninstrumented dev build finds nothing); --sanitizer=none
# buys the speed back. dbld's CI-parity baseline is opt-in; alpine never gets one.
if [ -z "$SANITIZER" ]; then
  case "$MODE" in
    dbld)   SANITIZER=none ;;
    alpine) ;;   # left empty; the alpine guard treats a non-empty SANITIZER as an explicit --sanitizer
    *)      SANITIZER=address ;;
  esac
fi

if [ "$MONOLITHIC" -eq 1 ] && [ "$MODE" != autotools ] && [ "$MODE" != dbld ]; then
  fail "--monolithic is autotools/dbld only ($MODE has no monolithic linking mode)"
fi

if [ "$NO_LLD" -eq 1 ] && [ "$MODE" != cmake ]; then
  fail "--no-lld is cmake-only; only the cmake build links with lld"
fi

if [ "$MODE" = dbld ] && [ "$DO_INSTALL" -eq 0 ]; then
  fail "--no-install does not apply to dbld; it always installs into the container prefix"
fi

if [ "$MODE" = dbld ] && [ -n "$JOBS" ]; then
  fail "-j does not apply to dbld; the container manages build parallelism"
fi

# alpine is a fixed production image build and takes no build flavor at all.
if [ "$MODE" = alpine ] && { [ -n "$SANITIZER" ] || [ "$CLEAN" -eq 1 ] || [ "$NO_JIT" -eq 1 ] \
     || [ "$DO_INSTALL" -eq 0 ] || [ -n "$JOBS" ]; }; then
  fail "alpine is a fixed production build; it takes no build flavors, only --check/--light"
fi

# `-- <args>` belong to a test runner, so exactly one action must own them.
if [ "${#EXTRA_ARGS[@]}" -gt 0 ] && [ "$((DO_CHECK + DO_LIGHT))" -ne 1 ]; then
  fail "arguments after -- need exactly one of --check/--light to receive them"
fi

# --light needs the installed binary (alpine runs against its image, rejected above)
if [ "$DO_LIGHT" -eq 1 ] && [ "$DO_INSTALL" -eq 0 ]; then
  fail "--light needs the installed binary; drop --no-install"
fi

# -j defaults only where the wrapper drives make/ninja; dbld/alpine manage their own
if [ -z "$JOBS" ]; then
  case "$MODE" in
    cmake|autotools) JOBS="${AXOSYSLOG_BUILD_JOBS:-$(default_jobs)}" ;;
  esac
fi

ROOT="$(git -C "$(pwd)" rev-parse --show-toplevel 2>/dev/null)" || fail "not inside a git checkout"
# guard the destructive steps (--clean rm -rf) against an unrelated current repo
[ -f "$ROOT/configure.ac" ] || fail "not an AxoSyslog checkout: $ROOT"

# dbld/alpine bind-mount the checkout into a container. dbld/rules mounts the git
# common-dir, but a linked worktree's submodule gitdirs (lib/ivykis) are recorded
# against the main checkout and still don't resolve there -- so plain checkout only.
if [ -f "$ROOT/.git" ]; then
  case "$MODE" in
    dbld|alpine) fail "$MODE does not work from a git worktree; run it from a plain checkout" ;;
  esac
fi

# --- one build mode per tree; switch with --clean ---------------------------
# Mixing modes regenerates lib/ivykis with a different libtool and corrupts it.
# --clean is the blunt reset (fresh build dir + ivykis recovery), every use.
detect_mode() {
  # first match wins: after a sanctioned switch (cmake --clean in a dbld tree) both
  # a native and a dbld marker exist, since a host build never deletes dbld/build/
  if   [ -f "$ROOT/build/CMakeCache.txt" ];      then echo cmake
  elif [ -f "$ROOT/build/config.status" ];       then echo autotools
  elif [ -f "$ROOT/dbld/build/config.status" ];  then echo dbld
  else echo none
  fi
}
existing="$(detect_mode)"
# alpine builds in the container and owns no in-tree build dir, so it is exempt.
if [ "$MODE" != alpine ] && [ "$existing" != none ] && [ "$existing" != "$MODE" ] && [ "$CLEAN" -eq 0 ]; then
  fail "this tree is set up for '$existing'; building '$MODE' on top of it would corrupt lib/ivykis. Re-run with --clean to switch (it wipes build/ and recovers lib/ivykis)."
fi

# --- fail early on missing tooling (host builds only) -----------------------
# dbld/alpine build inside a container image that already carries the toolchain.
require_tools() {
  case "$MODE" in autotools|cmake) ;; *) return 0 ;; esac

  local missing=()
  have "$CC"  || missing+=("$CC (C compiler; the default stack uses clang)")
  have "$CXX" || missing+=("$CXX (C++ compiler)")

  if [ "$MODE" = cmake ]; then
    have cmake || missing+=("cmake")
    have ninja || missing+=("ninja (package: ninja-build)")
    [ "$NO_LLD" -eq 0 ] && { have ld.lld || have lld || missing+=("lld (ld.lld) -- or pass --no-lld"); }
  else
    have make       || missing+=("make")
    have autoreconf || missing+=("autoreconf (package: autoconf)")
    have automake   || missing+=("automake")
    have libtoolize || have glibtoolize || missing+=("libtool")
    have_ax_macros  || missing+=("autoconf-archive (autogen.sh needs its AX_* macros)")
  fi

  [ "$NO_JIT" -eq 0 ] && { have_llvm || missing+=("llvm (llvm-config; the filterx JIT needs it) -- or pass --no-jit"); }

  [ "${#missing[@]}" -eq 0 ] && return 0

  warn "missing tooling for the default $MODE setup:"
  local m
  for m in "${missing[@]}"; do warn "  - $m"; done
  warn "install it (Debian/Ubuntu: sudo apt install clang lld llvm ninja-build cmake autoconf automake autoconf-archive libtool)"
  fail "or choose a lighter setup (e.g. --no-jit, --no-lld, or a different mode)."
}

if [ "$MODE" = alpine ]; then
  say "alpine: musl production image via dbld docker (this is slow)"
  # pull the exact builder the prod dockerfile FROMs (hardcoded ghcr.io/axoflow),
  # not docker-builder -- that recompiles grpcio (~30 min) and only tags :latest
  ALPINE_VERSION="$(sed -n 's/^ARG ALPINE_VERSION=//p' "$ROOT/docker/axosyslog.dockerfile" | head -1)"
  [ -n "$ALPINE_VERSION" ] || fail "cannot parse ALPINE_VERSION from docker/axosyslog.dockerfile"
  BUILDER_IMG="ghcr.io/axoflow/axosyslog-builder:$ALPINE_VERSION"
  if ! docker image inspect "$BUILDER_IMG" >/dev/null 2>&1; then
    say "alpine: pulling $BUILDER_IMG"
    docker pull "$BUILDER_IMG" || fail "pull of $BUILDER_IMG failed"
  fi
  ( cd "$ROOT" && ./dbld/rules docker )
  say "done: image built via ./dbld/rules docker"

  [ "$DO_CHECK" -eq 1 ] && say "note: unit tests ran during the image build (APKBUILD check())"

  # ./dbld/rules docker tagged the image :dbld-snapshot
  if [ "$DO_LIGHT" -eq 1 ]; then
    light_image="${CONTAINER_REGISTRY:-ghcr.io/axoflow}/axosyslog:dbld-snapshot"
    say "light/e2e against the image via the docker runner: $light_image"
    ( cd "$ROOT/tests/light" \
      && poetry install \
      && poetry run python -m pytest --showlocals --verbosity=3 functional_tests \
           --runner docker --docker-image "$light_image" "${EXTRA_ARGS[@]}" )
  fi
  exit 0
fi

require_tools

ivykis_recover() {
  say "recovering lib/ivykis (clean -fdx)"
  # best-effort: on a fresh clone lib/ivykis isn't a repo yet; --clean must still bootstrap
  git -C "$ROOT/lib/ivykis" clean -fdx >/dev/null 2>&1 || true
}

BIN=""

build_autotools() {
  local prefix="$ROOT/build/install"
  local extra=()
  [ "$SANITIZER" != none ] && extra+=(--with-sanitizer="$SANITIZER")
  [ "$MONOLITHIC" -eq 1 ] && extra+=(--with-linking-mode=monolithic)
  [ "$NO_JIT" -eq 1 ] && extra+=(--disable-jit)

  if [ "$CLEAN" -eq 1 ]; then
    say "clean: wiping build/"
    rm -rf "$ROOT/build"
    ivykis_recover
  fi

  if [ "$CLEAN" -eq 1 ] || [ ! -x "$ROOT/configure" ]; then
    say "bootstrap: ./autogen.sh"
    ( cd "$ROOT" && ./autogen.sh )
  fi

  mkdir -p "$ROOT/build"
  if [ ! -f "$ROOT/build/config.status" ]; then
    say "configure (autotools, sanitizer=$SANITIZER)"
    # config.status --recheck replays only argument-passed vars, so CC/CXX ride as args
    ( cd "$ROOT/build" && ../configure \
        CC="$CC" CXX="$CXX" \
        "${extra[@]}" \
        --enable-debug --enable-extra-warnings --enable-all-modules \
        --disable-java --disable-java-modules --enable-stackdump \
        --prefix="$prefix" )
  else
    warn "reusing existing build/config.status (run --clean to change flavors)"
  fi

  say "make -j$JOBS"
  make -C "$ROOT/build" -j"$JOBS"
  if [ "$DO_INSTALL" -eq 1 ]; then
    say "make install"
    make -C "$ROOT/build" install
  fi
  BIN="$prefix/sbin/syslog-ng"
}

build_cmake() {
  local prefix="$ROOT/build/install"
  # the wrapper's "none" is cmake's cache value OFF
  local san="$SANITIZER"
  [ "$san" = none ] && san=OFF
  local jitflag=()
  [ "$NO_JIT" -eq 1 ] && jitflag=(-DENABLE_JIT=OFF)
  local lldflag=()
  if [ "$NO_LLD" -eq 0 ]; then
    local kind
    for kind in EXE SHARED MODULE; do
      lldflag+=("-DCMAKE_${kind}_LINKER_FLAGS=-fuse-ld=lld")
    done
  fi

  if [ "$CLEAN" -eq 1 ]; then
    say "clean: wiping build/"
    rm -rf "$ROOT/build"
    ivykis_recover
  fi

  if [ ! -f "$ROOT/build/CMakeCache.txt" ]; then
    say "cmake configure (sanitizer=$SANITIZER)"
    cmake -G Ninja -B "$ROOT/build" -S "$ROOT" \
      -DCMAKE_C_COMPILER="$CC" -DCMAKE_CXX_COMPILER="$CXX" \
      -DSANITIZER="$san" \
      "${jitflag[@]}" \
      "${lldflag[@]}" \
      -DCMAKE_BUILD_TYPE=Debug -DENABLE_EXTRA_WARNINGS=ON \
      -DENABLE_JAVA=OFF -DENABLE_JAVA_MODULES=OFF -DENABLE_LIBUNWIND=ON \
      -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
      -DCMAKE_INSTALL_PREFIX="$prefix"
  else
    warn "reusing existing build/CMakeCache.txt (run --clean to change flavors)"
  fi

  say "cmake --build -j$JOBS"
  cmake --build "$ROOT/build" -j"$JOBS"
  if [ "$DO_INSTALL" -eq 1 ]; then
    say "cmake --install"
    cmake --install "$ROOT/build"
  fi
  BIN="$prefix/sbin/syslog-ng"
}

build_dbld() {
  local extra=""
  [ "$SANITIZER" != none ] && extra="$extra --with-sanitizer=$SANITIZER"
  [ "$MONOLITHIC" -eq 1 ] && extra="$extra --with-linking-mode=monolithic"
  [ "$NO_JIT" -eq 1 ] && extra="$extra --disable-jit"
  extra="${extra# }"

  if [ "$CLEAN" -eq 1 ]; then
    say "clean: ./dbld/rules clean"
    ( cd "$ROOT" && ./dbld/rules clean ) || true
    # drop the native build/ marker too, or detect_mode keeps refusing the
    # switched tree
    rm -rf "$ROOT/build"
    ivykis_recover
  fi

  # the $CLEAN term: a failed (swallowed) clean must not skip the re-bootstrap
  if [ "$CLEAN" -eq 1 ] || [ ! -f "$ROOT/dbld/build/config.status" ]; then
    say "dbld bootstrap${extra:+ (CONFIGURE_ADD=$extra)}"
    ( cd "$ROOT" && ./dbld/rules bootstrap CONFIGURE_ADD="$extra" )
  fi
  say "dbld make-install"
  ( cd "$ROOT" && ./dbld/rules make-install )
  BIN="$ROOT/dbld/install/sbin/syslog-ng"
}

run_check() {
  case "$MODE" in
    autotools)
      say "unit tests: make -j$JOBS check${EXTRA_ARGS[*]:+  ${EXTRA_ARGS[*]}}"
      make -C "$ROOT/build" -j"$JOBS" check "${EXTRA_ARGS[@]}" ;;
    cmake)
      say "unit tests: ctest -j$JOBS${EXTRA_ARGS[*]:+  ${EXTRA_ARGS[*]}}"
      # the cmake layout links systemd-journal both shared and static, so the
      # duplicated used_namespaces trips ASan's ODR check; autotools links it
      # static only
      ASAN_OPTIONS="detect_odr_violation=0" \
      ctest --test-dir "$ROOT/build" --parallel "$JOBS" --output-on-failure "${EXTRA_ARGS[@]}" ;;
    dbld)
      say "unit tests: dbld make-check${EXTRA_ARGS[*]:+  MAKE_ARGS=${EXTRA_ARGS[*]}}"
      ( cd "$ROOT" && ./dbld/rules make-check MAKE_ARGS="${EXTRA_ARGS[*]}" ) ;;
  esac
}

run_light() {
  case "$MODE" in
    autotools)
      say "light/e2e: make light-check${EXTRA_ARGS[*]:+  PYTEST_OPTS=${EXTRA_ARGS[*]}}"
      make -C "$ROOT/build" light-check PYTEST_OPTS="${EXTRA_ARGS[*]}" ;;
    cmake)
      say "light/e2e: cmake light-check${EXTRA_ARGS[*]:+  EXTRA_ARGS=${EXTRA_ARGS[*]}}"
      EXTRA_ARGS="${EXTRA_ARGS[*]}" \
      cmake --build "$ROOT/build" --target light-check ;;
    dbld)
      say "light/e2e: dbld make-light-check${EXTRA_ARGS[*]:+  PYTEST_OPTS=${EXTRA_ARGS[*]}}"
      ( cd "$ROOT" && PYTEST_OPTS="${EXTRA_ARGS[*]}" ./dbld/rules make-light-check ) ;;
  esac
}

case "$MODE" in
  autotools) build_autotools ;;
  cmake)     build_cmake ;;
  dbld)      build_dbld ;;
esac

[ "$DO_CHECK" -eq 1 ] && run_check
[ "$DO_LIGHT" -eq 1 ] && run_light

if [ -n "$BIN" ] && [ "$DO_INSTALL" -eq 1 ] && [ -x "$BIN" ]; then
  say "installed binary: $BIN"
  # smoke test: a binary that can't start (missing lib, bad module dir) must fail here
  ver="$("$BIN" -V)" || fail "installed binary does not run: $BIN"
  printf '%s\n' "${ver%%$'\n'*}"
fi
say "done ($MODE)"
