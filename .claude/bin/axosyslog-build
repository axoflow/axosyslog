#!/usr/bin/env bash
# axosyslog-build -- one wrapper for building & testing AxoSyslog.
#
# Usage:  axosyslog-build [mode] [flavors]
#
#   modes:   cmake|cm (default) | autotools|auto|at | dbld | alpine
#
#   flavors: --sanitizer=address|thread|undefined|none
#                                  default: address
#            --monolithic          link modules into the core lib (autotools/dbld
#                                  only). Default: dynamic.
#            -j N | --jobs N       parallelism (default: AXOSYSLOG_BUILD_JOBS if
#                                  set, else nproc-2, floor 1)
#            --no-install          skip the install step
#            --no-jit              disable the filterx LLVM JIT (default: on)
#
# Flavors are a closed set -- add new ones here on purpose rather than improvising
# configure flags.
set -euo pipefail

MODE=""
JOBS=""
SANITIZER=""
MONOLITHIC=0
DO_INSTALL=1
NO_JIT=0

say()  { printf '\033[1;34m>>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
fail() { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} /^$/{print; next} {exit}' "$0"
  exit "${1:-0}"
}

default_jobs() {
  local n
  n="$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)"
  if [ "$n" -gt 2 ]; then echo $((n - 2)); else echo 1; fi
}

case "${1:-}" in
  ""|-*)     MODE=cmake ;;   # a leading flag (incl. -h) keeps the default and falls into the loop
  *)         MODE="$1"; shift ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --sanitizer=*)  SANITIZER="${1#*=}"; [ -n "$SANITIZER" ] || fail "--sanitizer= needs a value" ;;
    --sanitizer)    shift; [ $# -gt 0 ] || fail "--sanitizer needs a value"; SANITIZER="$1" ;;
    --monolithic)   MONOLITHIC=1 ;;
    -j|--jobs)      shift; [ $# -gt 0 ] || fail "-j needs a value"; JOBS="$1" ;;
    -j*)            JOBS="${1#-j}" ;;
    --jobs=*)       JOBS="${1#*=}" ;;
    --no-install)   DO_INSTALL=0 ;;
    --no-jit)       NO_JIT=1 ;;
    -h|--help)      usage 0 ;;
    *)              fail "unknown argument: $1  (flavors are a closed set; add new ones to axosyslog-build on purpose)" ;;
  esac
  shift
done

# -j must be a positive integer -- else `-j <flag>` swallows the next arg as the count
if [ -n "$JOBS" ]; then
  case "$JOBS" in
    *[!0-9]*|'') fail "invalid -j '$JOBS'  (want a positive integer)" ;;
  esac
fi
[ -n "$JOBS" ] || JOBS="${AXOSYSLOG_BUILD_JOBS:-$(default_jobs)}"

case "$MODE" in
  autotools|auto|at) MODE=autotools ;;
  cmake|cm)          MODE=cmake ;;
  dbld)              MODE=dbld ;;
  alpine)            MODE=alpine ;;
  *) fail "unknown mode: '$MODE'  (want: cmake | autotools | dbld | alpine)" ;;
esac

case "$SANITIZER" in
  ""|address|thread|undefined|none) ;;
  *) fail "invalid --sanitizer='$SANITIZER'  (want: address | thread | undefined | none)" ;;
esac

# ASan by default: an uninstrumented dev build finds nothing; buy the speed
# back with --sanitizer=none.
[ -n "$SANITIZER" ] || SANITIZER=address

if [ "$MONOLITHIC" -eq 1 ] && [ "$MODE" != autotools ] && [ "$MODE" != dbld ]; then
  fail "--monolithic is autotools/dbld only ($MODE has no monolithic linking mode)"
fi

ROOT="$(git -C "$(pwd)" rev-parse --show-toplevel 2>/dev/null)" || fail "not inside a git checkout"
# guard the destructive steps (--clean rm -rf) against an unrelated current repo
[ -f "$ROOT/configure.ac" ] || fail "not an AxoSyslog checkout: $ROOT"

BIN=""

build_autotools() { fail "autotools: not implemented yet"; }

build_cmake() { fail "cmake: not implemented yet"; }

build_dbld() { fail "dbld: not implemented yet"; }

case "$MODE" in
  autotools) build_autotools ;;
  cmake)     build_cmake ;;
  dbld)      build_dbld ;;
  alpine)    fail "alpine: not implemented yet" ;;
esac

if [ -n "$BIN" ] && [ "$DO_INSTALL" -eq 1 ] && [ -x "$BIN" ]; then
  say "installed binary: $BIN"
  # smoke test: a binary that can't start (missing lib, bad module dir) must fail here
  ver="$("$BIN" -V)" || fail "installed binary does not run: $BIN"
  printf '%s\n' "${ver%%$'\n'*}"
fi
say "done ($MODE)"
