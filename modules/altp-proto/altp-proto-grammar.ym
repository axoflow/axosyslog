%code top {
#include "altp-proto-parser.h"

}


%code {

#include "altp-proto-options.h"
#include "cfg-parser.h"
#include "cfg-grammar-internal.h"
#include "messages.h"

/* the options of the transport(altp(...)) being parsed, so that the option
 * rules below can reach them */
static AltpProtoServerOptions *last_altp_options;

}

%define api.prefix {altp_proto_}

/* this parameter is needed in order to instruct bison to use a complete
 * argument list for yylex/yyerror */

%lex-param {CfgLexer *lexer}
%parse-param {CfgLexer *lexer}
%parse-param {LogProtoServerFactory **instance}
%parse-param {gpointer arg}

/* INCLUDE_DECLS */

%token KW_ALTP
%token KW_ACK_TIMEOUT
%token KW_ACK_TIMEOUT_ACTION
%token KW_CLOSE
%token KW_PARTIAL_ACK
%token KW_SESSION_EXPIRATION
%token KW_MAX_SESSIONS
%token KW_TLS_POLICY
%token KW_REQUIRED
%token KW_ALLOW_COMPRESSION

%type <num> altp_ack_timeout_action
%type <num> altp_tls_policy

%%

start
        : LL_CONTEXT_SERVER_PROTO altp_transport
          {
            if (yychar != ALTP_PROTO_EMPTY)
              cfg_lexer_unput_token(lexer, &yylval);
            YYACCEPT;
          }
        ;

altp_transport
        : KW_ALTP
          {
            /* @arg is the last_proto_server_options of the driver, which is
             * the LogProtoServerOptionsStorage union our options extend */
            last_altp_options = altp_proto_server_options_defaults((LogProtoServerOptions *) arg);
            *instance = altp_proto_server_options_get_factory(last_altp_options);
          }
          altp_options_block
        ;

/* transport(altp) with no option block means all defaults */
altp_options_block
        : '(' altp_options ')'
        |
        ;

altp_options
        : altp_option altp_options
        |
        ;

altp_option
        : KW_ACK_TIMEOUT '(' positive_integer ')'
          {
            last_altp_options->altp.ack_timeout = $3;
          }
        | KW_ACK_TIMEOUT_ACTION '(' altp_ack_timeout_action ')'
          {
            last_altp_options->altp.ack_timeout_action = $3;
          }
        | KW_SESSION_EXPIRATION '(' positive_integer ')'
          {
            last_altp_options->altp.session_expiration = $3;
          }
        | KW_MAX_SESSIONS '(' nonnegative_integer ')'
          {
            /* max-sessions(0) is unlimited */
            last_altp_options->altp.max_sessions = $3;
          }
        | KW_TLS_POLICY '(' altp_tls_policy ')'
          {
            last_altp_options->altp.tls_policy = $3;
          }
        | KW_ALLOW_COMPRESSION '(' yesno ')'
          {
            last_altp_options->altp.allow_compression = $3;
          }
        ;

altp_ack_timeout_action
        : KW_CLOSE                              { $$ = ALTP_ACK_TIMEOUT_ACTION_CLOSE; }
        | KW_PARTIAL_ACK                        { $$ = ALTP_ACK_TIMEOUT_ACTION_PARTIAL_ACK; }
        ;

altp_tls_policy
        : KW_REQUIRED                           { $$ = ALTP_TLS_POLICY_REQUIRED; }
        | KW_OPTIONAL                           { $$ = ALTP_TLS_POLICY_OPTIONAL; }
        ;

/* INCLUDE_RULES */

%%
