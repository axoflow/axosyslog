%code top {
#include "altp-proto-client-parser.h"

}


%code {

#include "altp-proto-options.h"
#include "cfg-parser.h"
#include "cfg-grammar-internal.h"
#include "messages.h"

/* the options of the transport(altp(...)) being parsed, so that the option
 * rules below can reach them */
static AltpProtoClientOptions *last_altp_client_options;

}

%define api.prefix {altp_proto_client_}

/* this parameter is needed in order to instruct bison to use a complete
 * argument list for yylex/yyerror */

%lex-param {CfgLexer *lexer}
%parse-param {CfgLexer *lexer}
%parse-param {LogProtoClientFactory **instance}
%parse-param {gpointer arg}

/* INCLUDE_DECLS */

%token KW_ALTP
%token KW_ACK_TIMEOUT
%token KW_MAX_FRAME_SIZE

%%

start
        : LL_CONTEXT_CLIENT_PROTO altp_client_transport
          {
            if (yychar != ALTP_PROTO_CLIENT_EMPTY)
              cfg_lexer_unput_token(lexer, &yylval);
            YYACCEPT;
          }
        ;

altp_client_transport
        : KW_ALTP
          {
            /* @arg is the last_proto_client_options of the driver, which is
             * the LogProtoClientOptionsStorage union our options extend */
            last_altp_client_options = altp_proto_client_options_defaults((LogProtoClientOptions *) arg);
            *instance = altp_proto_client_options_get_factory(last_altp_client_options);
          }
          altp_client_options_block
        ;

/* transport(altp) with no option block means all defaults */
altp_client_options_block
        : '(' altp_client_options ')'
        |
        ;

altp_client_options
        : altp_client_option altp_client_options
        |
        ;

altp_client_option
        : KW_ACK_TIMEOUT '(' positive_integer ')'
          {
            last_altp_client_options->altp.ack_timeout = $3;
          }
        | KW_MAX_FRAME_SIZE '(' positive_integer ')'
          {
            last_altp_client_options->altp.max_frame_size = $3;
          }
        ;

/* INCLUDE_RULES */

%%
