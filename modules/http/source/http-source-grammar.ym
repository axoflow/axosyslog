/* REQUIRE lib/http/source/http-source-grammar.ym */

%code requires {

#include "http-source-parser.h"

}

%code {

#include "cfg-grammar-internal.h"
#include "syslog-ng.h"
#include "cfg-parser.h"
#include "http-source.h"
#include "messages.h"
#include "syslog-names.h"
#include "plugin.h"
#include "service-management.h"

}

%define api.prefix {http_source_}
%lex-param {CfgLexer *lexer}
%parse-param {CfgLexer *lexer}
%parse-param {LogDriver **instance}
%parse-param {gpointer arg}

/* INCLUDE_DECLS */

%token KW_EHTTP
%token KW_MODE
%token KW_AUTH_TOKEN
%token KW_RESPONSE_BODY

%%

start
  : LL_CONTEXT_SOURCE KW_EHTTP
    {
      EHTTPSourceDriver *d = ehttp_sd_new(configuration);
      http_source_grammar_set_source_driver(&d->super);
      *instance = &d->super.super.super.super;
    }
    '(' source_http_options ')'
    {
      if (yychar != HTTP_SOURCE_EMPTY)
        cfg_lexer_unput_token(lexer, &yylval);
      YYACCEPT;
    }
  ;

source_http_options
	: source_http_option source_http_options
	|
	;

source_http_option
	: KW_MODE '(' string ')'
    {
      CHECK_ERROR(ehttp_sd_set_mode(last_driver, $3), @3, "invalid mode() value");
      free($3);
    }
	| KW_AUTH_TOKEN '(' string ')'
    {
      ehttp_sd_set_auth_token(last_driver, $3);
      free($3);
    }
	| KW_RESPONSE_BODY '(' template_name_or_content ')'
    {
      ehttp_sd_set_response_body(last_driver, $3);
      log_template_unref($3);
    }
	| http_source_option
  ;

/* INCLUDE_RULES */

%%
