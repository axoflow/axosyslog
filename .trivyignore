# msgpack: SEGV/DoS on Unpacker reuse after an error.
# pip only calls one-shot dumps()/loads(), never an Unpacker.
# Remove with a pip vendoring msgpack 1.2.1+, expected in 26.3:
# https://github.com/pypa/pip/issues/14224
GHSA-6v7p-g79w-8964 exp:2026-11-15

# msgpack: memory leak in unpackb()/Unpacker when a map key is rejected
# (strict_map_key). Same vendored copy, same one-shot use at build time.
# Fixed in msgpack 1.2.3; pip main already vendors it, no release yet.
# Remove with a pip vendoring msgpack 1.2.3+, expected in 26.3.
CVE-2026-114613 exp:2026-11-15

# setuptools: path traversal in PackageIndex.download.
# pip vendors only pkg_resources, and the image ships no package_index.py.
# Remove once pip stops pinning a vulnerable setuptools:
# https://github.com/pypa/pip/issues/14224
# https://github.com/pypa/pip/issues/14031
CVE-2025-47273 exp:2026-11-15

# setuptools: MANIFEST.in exclusion bypass when building sdists.
# Not vendored into pip either.
# The image's own setuptools is 84.0.0, past the 83.0.0 fix.
# Remove once pip stops pinning a vulnerable setuptools.
CVE-2026-59890 exp:2026-11-15

# setuptools: Windows path escape via namespace_packages.txt.
# The flaw is in setuptools/wheel.py (_fix_namespace_packages, reached from
# Wheel.install_as_egg). pip vendors only pkg_resources, so that module is
# absent; trivy reports it from pip's SBOM at pip/_vendor/bom.cdx.json, which
# pins setuptools 70.3.0. Windows-only besides, and the image is Alpine.
# Remove once pip vendors setuptools >= 84.1.0:
# https://github.com/pypa/pip/issues/14224
GHSA-xmj3-9gf7-h52w exp:2026-11-15

# urllib3: HTTPS proxy TLS configuration override (CVE-2026-97687),
# unbounded memory allocation in the chunk parser (CVE-2026-97689) and
# infinite loop in chunked Deflate decoding (CVE-2026-97688).
# Only pip's vendored copy is 2.7.0, reported by trivy from pip's own
# SBOM at pip/_vendor/bom.cdx.json. The venv's real urllib3 is 2.8.0
# and pip itself only runs at image build time.
# Remove once pip vendors urllib3 >= 2.8.0 (expected in pip 26.3):
# https://github.com/pypa/pip/blob/main/src/pip/_vendor/vendor.txt
CVE-2026-97687 exp:2026-11-15
CVE-2026-97688 exp:2026-11-15
CVE-2026-97689 exp:2026-11-15
